<!-- Global Spinner -->
<div id="global-spinner" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.75); z-index:99999; justify-content:center; align-items:center;">
    <div style="width:44px; height:44px; border:4px solid #ebebeb; border-top-color:#fe424d; border-radius:50%; animation:globalSpin 0.7s linear infinite;"></div>
</div>

<style>
    @keyframes globalSpin { to { transform: rotate(360deg); } }
</style>

<script>
    const _spinner = document.getElementById('global-spinner');

    function showSpinner() {
        _spinner.style.display = 'flex';
    }

    // Show on all form submits
    document.addEventListener('submit', function(e) {
        showSpinner();
    });

    // Show on all anchor clicks that navigate away
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if(link && link.href && !link.href.startsWith('mailto') && !link.target && link.hostname === location.hostname) {
            showSpinner();
        }
    });

    // Hide spinner if page is shown from cache (back/forward)
    window.addEventListener('pageshow', function(e) {
        _spinner.style.display = 'none';
    });
</script>
