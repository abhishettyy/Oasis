<%-include('../includes/header.ejs') %>
<body>
    <%- include('../includes/flash.ejs') %>

    <nav class="navbar">
        <div class="nav-container">
            <div class="brand-group">
                <div class="nav-logo">
                    <i class="fa-solid fa-compass"></i>
                    <span class="logo-text">Oasis</span>
                </div>
                <p class="nav-tagline">Finding that one perfect spot in a desert of options</p>
            </div>
            <div class="nav-links">
                <a href="/listings">Home</a>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="form-wrapper">
            <h2 class="form-heading">Add Your Place</h2>
            <p style="color:#717171; margin-bottom:2rem; font-size:0.95rem;">Fill in the details below to list your space on Oasis.</p>

            <form method="POST" action="/listings" class="listing-form needs-validation" novalidate enctype="multipart/form-data">

                <div class="form-group">
                    <label for="title">Place Name</label>
                    <input type="text" name="listing[title]" id="title" class="form-control" placeholder="e.g. Cozy Beach House in Goa" required>
                    <div class="invalid-feedback">Please enter a name for your place.</div>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea name="listing[description]" class="form-control" id="description" rows="4" placeholder="Describe your place — what makes it special?" required></textarea>
                    <div class="invalid-feedback">Please add a description.</div>
                </div>

                <div class="form-group">
                    <label for="image">Upload Image</label>
                    <input type="file" name="image" accept="image/*" id="image" class="form-control">
                </div>

                <div class="row">
                    <div class="form-group col-price">
                        <label for="price">Overall Expense (₹)</label>
                        <div class="price-input">
                            <span>&#8377;</span>
                            <input type="number" name="listing[price]" class="form-control" id="price" placeholder="5000" required>
                        </div>
                        <div class="invalid-feedback">Enter a valid amount.</div>
                    </div>

                    <div class="form-group col-country">
                        <label for="country">Country</label>
                        <input type="text" class="form-control" name="listing[country]" id="country" placeholder="India" required>
                        <div class="invalid-feedback">Enter the country.</div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" name="listing[location]" id="location" class="form-control" placeholder="e.g. Jaipur, Rajasthan" required>
                    <div class="invalid-feedback">Please enter a location.</div>
                </div>

                <button class="btn btn-add">List My Place</button>
            </form>
        </div>
    </main>

    <%- include('../includes/footer.ejs') %>
    <script src="/js/formValidate.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
